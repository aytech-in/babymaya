rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Everyone can read the status. Only your own account can change it.
    match /status/current {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == 'PASTE_YOUR_USER_UID_HERE';
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
